<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reperi.autocare">

    <!-- ======================================
         FILE PICKER PERMISSIONS
         Required for insurance claim document uploads
         ====================================== -->
    
    <!-- READ_EXTERNAL_STORAGE: Allows app to read files from device storage -->
    <!-- Required for: Picking PDF files (RC, License, Aadhaar, PAN, Insurance) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- WRITE_EXTERNAL_STORAGE: Allows app to write/save files to device storage -->
    <!-- Required for: Saving temporary files during upload -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    
    <!-- ======================================
         ANDROID 13+ SPECIFIC PERMISSIONS
         These replace READ/WRITE_EXTERNAL_STORAGE on newer Android versions
         ====================================== -->
    
    <!-- READ_MEDIA_IMAGES: Allows app to read image files (damage photos) -->
    <!-- Android API 33+: Required instead of READ_EXTERNAL_STORAGE for images -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- READ_MEDIA_VIDEO: Allows app to read video files -->
    <!-- Android API 33+: Future-proofing if video uploads are added -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    
    <!-- READ_MEDIA_AUDIO: Allows app to read audio files -->
    <!-- Android API 33+: Future-proofing if audio uploads are added -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- ======================================
         APPLICATION CONFIGURATION
         ====================================== -->
    <application
        android:label="Reperi Garage"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        
        <!-- Main Activity for Flutter app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Specifies the default intent filters for the activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Don't delete the meta-data below -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>