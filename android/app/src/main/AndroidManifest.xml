<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reperi.autocare.app">

    <!-- ======================================
         FILE PICKER PERMISSIONS
         Required for insurance claim document uploads
         ====================================== -->
    
    <!-- READ_EXTERNAL_STORAGE: Allows app to read files from device storage -->
    <!-- Required for: Picking PDF files (RC, License, Aadhaar, PAN, Insurance) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- ======================================
         ANDROID 13+ SPECIFIC PERMISSIONS
         These replace READ/WRITE_EXTERNAL_STORAGE on newer Android versions
         ====================================== -->
    
    <!-- READ_MEDIA_IMAGES: Allows app to read image files (damage photos) -->
    <!-- Android API 33+: Required instead of READ_EXTERNAL_STORAGE for images -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ======================================
         LOCATION PERMISSIONS
         Required for address detection via GPS
         ====================================== -->
    
    <!-- ACCESS_FINE_LOCATION: Allows app to get precise GPS location -->
    <!-- Required for: Detecting exact address using GPS coordinates -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    
    <!-- ACCESS_COARSE_LOCATION: Allows app to get approximate location -->
    <!-- Required for: Fallback location detection if GPS unavailable -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ======================================
         CAMERA PERMISSIONS
         Required for vehicle photo capture
         ====================================== -->
    
    <!-- CAMERA: Allows app to access device camera -->
    <!-- Required for: Taking inspection photos, vehicle damage photos, vehicle registration photos -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ======================================
         NOTIFICATION PERMISSIONS
         Required for push notifications
         ====================================== -->
    
    <!-- POST_NOTIFICATIONS: Allows app to send notifications -->
    <!-- Android API 33+: Required for push notifications (OneSignal) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ======================================
         NETWORK PERMISSIONS
         Required for API calls and backend communication
         ====================================== -->
    
    <!-- INTERNET: Allows app to access network connections -->
    <!-- Required for: API calls, Supabase, Razorpay, push notifications -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ======================================
         APPLICATION CONFIGURATION
         ====================================== -->
    <application
        android:label="Reperi Garage"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        
        <!-- Main Activity for Flutter app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Specifies the default intent filters for the activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Handles the "reperi://reset-password" deep link that
                 Supabase's password-reset email redirects to (see
                 resetPasswordForEmail's redirectTo in login_screen.dart).
                 Without this, Android has no app registered for the
                 "reperi" scheme, so tapping the reset link in the email
                 just opens the browser and goes nowhere — the link never
                 reaches the app. iOS already has this scheme declared in
                 Info.plist's CFBundleURLTypes. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="reperi" android:host="reset-password" />
            </intent-filter>
        </activity>
        
        <!-- Don't delete the meta-data below -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>